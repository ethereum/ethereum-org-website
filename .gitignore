# dependencies
/node_modules
/.pnp
.pnp.js
.pnpm-store/

# testing
/coverage
tests/__results__/
tests/__report__/
test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log

pnpm-lock.yaml.bak

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rss feeds
/feed.xml

# Sitemaps (root-level generated output only; anchored so the app/sitemap.xml/
# route handler that serves the <sitemapindex> stays tracked -- mirrors /feed.xml)
/sitemap*.xml

# Robots.txt (root-level generated output only; anchored so the app/robots.txt/
# route handler stays tracked -- mirrors /sitemap*.xml above)
/robots.txt

# Local Netlify folder
.netlify

# workplace configuration
.vscode
.idea

# Crowdin report output
src/data/crowdin/bucketsAwaitingReviewReport.csv

# Storybook
build-storybook.log
build-archive.log
storybook-static
storybook-static-pages

# Trigger
.trigger

# Git worktrees for Claude commands
.worktrees

# Hide skill eval workspaces
.claude/skills/*-workspace

# Playwright CLI session state
.playwright-cli

# Claude Code worktrees
.claude/worktrees/
